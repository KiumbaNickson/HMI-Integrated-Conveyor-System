        "type": "function",
        "z": "b815d73ef5abcb55",
        "name": "WEIGHT LIMITS(CONV)",
        "func": "let limitValue = parseFloat(msg.payload);\n\n// Convert float to 4-byte Big-Endian buffer\nlet buf = Buffer.alloc(4);\nbuf.writeFloatBE(limitValue, 0);\n\n// Output two 16-bit integers for Modbus FC16\nmsg.payload = [\n    buf.readUInt16BE(0),\n    buf.readUInt16BE(2)\n];\n\nreturn msg;",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
