        "head": "",
        "format": "<template>\n    <div class=\"indicator-container\">\n        <span class=\"indicator-label\">MOTOR STATUS</span>\n        <div class=\"indicator-lamp\" :class=\"{ 'active': msg?.payload }\"></div>\n        <span class=\"indicator-text\" :class=\"{ 'active-text': msg?.payload }\">\n            {{ msg?.payload ? 'RUNNING' : 'STOPPED' }}\n        </span>\n    </div>\n</template>\n\n<script>\n    export default {\n    data() {\n        return {\n            // Internal state managed automatically via Dashboard 2.0 msg binding\n        }\n    }\n}\n</script>\n\n<style>\n    .indicator-container {\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        justify-content: center;\n        padding: 12px;\n    }\n\n    .indicator-label {\n        font-weight: bold;\n        font-size: 13px;\n        color: #aaaaaa;\n        margin-bottom: 8px;\n    }\n\n    .indicator-lamp {\n        width: 48px;\n        height: 48px;\n        border-radius: 50%;\n        background-color: #333333;\n        border: 2px solid #555555;\n        transition: all 0.3s ease;\n    }\n\n    .indicator-lamp.active {\n        background-color: #00E676;\n        border-color: #00E676;\n        box-shadow: 0 0 16px #00E676;\n    }\n\n    .indicator-text {\n        margin-top: 8px;\n        font-weight: bold;\n        font-size: 12px;\n        color: #888888;\n    }\n\n    .indicator-text.active-text {\n        color: #00E676;\n    }\n</style>",
