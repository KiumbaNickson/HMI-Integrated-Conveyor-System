        "name": "E-STOP INDICATOR",
        "order": 2,
        "width": 0,
        "height": 0,
        "head": "",
        "format": "<template>\n    <div style=\"display: flex; align-items: center; justify-content: space-between; padding: 12px; background-color: #1e1e1e; border-radius: 6px;\"\n         :style=\"{ 'border-left': '8px solid ' + (estopHealthy ? '#4caf50' : '#f44336') }\">\n        \n        <div style=\"display: flex; align-items: center; gap: 10px;\">\n            <span style=\"height: 16px; width: 16px; border-radius: 50%; display: inline-block;\"\n                  :style=\"{ 'background-color': estopHealthy ? '#4caf50' : '#f44336', 'box-shadow': '0 0 8px ' + (estopHealthy ? '#4caf50' : '#f44336') }\">\n            </span>\n            <span style=\"font-weight: bold; font-size: 14px; color: #ffffff;\">EMERGENCY STOP</span>\n        </div>\n\n        <span style=\"font-size: 12px; font-weight: bold; padding: 6px 12px; border-radius: 4px; color: #ffffff;\"\n              :style=\"{ 'background-color': estopHealthy ? '#2e7d32' : '#d32f2f' }\">\n            {{ estopHealthy ? 'E-STOP HEALTHY' : 'EMERGENCY STOP TRIPPED' }}\n        </span>\n    </div>\n</template>\n\n<script>\nexport default {\n    data() {\n        return {\n            // Receives boolean directly from function 2 payload\n            estopHealthy: true \n        }\n    },\n    watch: {\n        msg: {\n            handler(msg) {\n                if (msg && msg.payload !== undefined) {\n                    // Update reactive state whenever a new payload arrives\n                    this.estopHealthy = Boolean(msg.payload);\n                }\n            },\n            immediate: true,\n            deep: true\n        }\n    }\n}\n</script>",
