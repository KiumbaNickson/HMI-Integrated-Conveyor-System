    {
        "id": "1b6b403422a3ff40",
        "type": "function",
        "z": "b815d73ef5abcb55",
        "name": "function 2",
        "func": "// Array of 4 inputs read from Modbus starting at Address 2 (%IX0.2 to %IX0.5)\nconst inputs = msg.payload || [];\n\n// 1. Address 2 (%IX0.2) - ESTOP_OK (Normally Closed safety circuit)\nconst rawEstop = inputs[0] ?? false;\nconst estopHealthy = !rawEstop; // Inverted: True = Fault / Triggered\n\n// 2. Address 3 (%IX0.3) - OVRLOAD_OK (Normally Closed thermal overload)\nconst rawOverload = inputs[1] ?? false;\nconst overloadHealthy = !rawOverload; // Inverted: True = Trip / Fault\n\n// 3. Address 4 (%IX0.4) - PRODUCT_SENSOR (Normally Open photo-eye)\nconst productDetected = inputs[2] ?? false;\n\n// 4. Address 5 (%IX0.5) - QUALITY_SENSOR (Normally Open vision/check sensor)\nconst qualityStatus = inputs[3] ?? false;\n\n// Output messages for each dashboard indicator port\nconst msgEstop = { payload: estopHealthy };\nconst msgOverload = { payload: overloadHealthy };\nconst msgProduct = { payload: productDetected };\nconst msgQuality = { payload: qualityStatus };\n\n// Wire outputs 1 through 4\nreturn [msgEstop, msgOverload, msgProduct, msgQuality];",
        "outputs": 4,
        "timeout": 0,
