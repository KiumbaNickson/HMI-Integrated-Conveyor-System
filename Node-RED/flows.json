    {
        "id": "76662f0a1e5ad5ab",
        "type": "function",
        "z": "b815d73ef5abcb55",
        "name": "function 1",
        "func": "// 1. Retrieve or initialize context values\nlet coils = flow.get('coils') || [false, false, false, false];\nlet count = flow.get('count') || 0;\n\n// 2. Process Modbus Coils (%QX0.0 to %QX0.3)\nif (Array.isArray(msg.payload)) {\n    coils = msg.payload.map(val => Boolean(val));\n    flow.set('coils', coils);\n} else if (typeof msg.payload === 'object' && msg.payload !== null && msg.payload.data) {\n    coils = msg.payload.data.map(val => Boolean(val));\n    flow.set('coils', coils);\n}\n\n// 3. Process Modbus Holding Register (%MW0 - Batch Count)\nif (typeof msg.payload === 'number') {\n    count = msg.payload;\n    flow.set('count', count);\n} else if (Array.isArray(msg.payload) && typeof msg.payload[0] === 'number') {\n    count = msg.payload[0];\n    flow.set('count', count);\n} else if (typeof msg.payload === 'object' && msg.payload !== null && msg.payload.data) {\n    count = Number(msg.payload.data[0]) || 0;\n    flow.set('count', count);\n}\n\n// 4. Calculate 3-State Logic\n// %QX0.3 (coils[3]) indicates BATCH_COMPLETE_LAMP in OpenPLC\nlet isComplete = Boolean(coils[3]);\nlet statusString = \"IDLE\";\n\nif (isComplete) {\n    statusString = \"COMPLETE\";\n} else if (count > 0) {\n    statusString = \"IN PROGRESS\";\n}\n\n// 5. Send mapped signals to outputs\nreturn [\n    { payload: coils[0] },        // Output 1: MOTOR STATUS (%QX0.0)[cite: 1]\n    { payload: coils[1] },        // Output 2: LAMP_RUN (%QX0.1)[cite: 1]\n    { payload: coils[2] },        // Output 3: REJECT SELENOID (%QX0.2)[cite: 1]\n    {                             // Output 4: BATCH STATUS Dashboard UI Template[cite: 1]\n        payload: { \n            status: statusString, \n            count: count \n        } \n    }\n];",
        "outputs": 4,
